# =============================================================================
# Local secrets & tuning — copy to `.env` in this same folder:
#   cp .env.example .env
# Then edit `.env`. It is gitignored; only `.env.example` is committed.
# =============================================================================

# --- LLM (never commit real keys) ---
XAI_API_KEY=
GOOGLE_API_KEY=
ACTIVE_LLM_PROVIDER=grok

# --- Demo / recovery ---
# 1 = skip JSONL replay on startup (clean ContextManager each run)
FRESH_START=0
REPLAY_LOOKBACK_HOURS=2

# --- Models ---
WHISPER_MODEL=medium
PIPER_VOICE=en_US-amy-medium
YOLO_MODEL=yolov10s.pt
INSIGHTFACE_MODEL=buffalo_l

# --- Performance ---
TARGET_FPS=5
FRAME_WIDTH=640
FRAME_HEIGHT=480
NUDGE_AUTO_DISMISS_SECONDS=10

# --- Paths (relative paths are under home-server/) ---
STORAGE_ROOT=./storage
EVENTS_DIR=./storage/events
FACES_DIR=./storage/faces
FEEDBACK_DIR=./storage/feedback
NUDGES_DIR=./storage/nudges
ONBOARDING_FILE=./storage/onboarding.json

# --- Edge client (documentation only; Settings ignores unknown keys.) ---
# Point your browser app at your machine, e.g.:
# HOME_SERVER_WS_URL=ws://192.168.1.42:8000/ws/stream
