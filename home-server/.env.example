# --- LLM Providers ---
# xAI Grok (confirmed working: image input + tool calling)
XAI_API_KEY=your_xai_key_here

# Google Gemini AI Studio (Gemini 3 Flash, vision-capable)
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Active provider: "grok" or "gemini" (overridable via Streamlit Settings)
ACTIVE_LLM_PROVIDER=grok

# --- Edge connection ---
# Edge devices connect to this WebSocket URL
HOME_SERVER_WS_URL=ws://your-pc-lan-ip:8000/ws/stream

# --- Models ---
WHISPER_MODEL=medium                # tiny, small, medium, large-v3
PIPER_VOICE=en_US-amy-medium        # warm, natural
YOLO_MODEL=yolov10s.pt
INSIGHTFACE_MODEL=buffalo_l

# --- Performance ---
TARGET_FPS=5
FRAME_WIDTH=640
FRAME_HEIGHT=480
NUDGE_AUTO_DISMISS_SECONDS=10

# --- Paths ---
STORAGE_ROOT=./storage
EVENTS_DIR=./storage/events
FACES_DIR=./storage/faces
FEEDBACK_DIR=./storage/feedback
NUDGES_DIR=./storage/nudges
ONBOARDING_FILE=./storage/onboarding.json
